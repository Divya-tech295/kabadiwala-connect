{
  "flutter": {
    "platforms": {
      "android": {
        "default": {
          "projectId": "kabadiwala-connect-d4df6",
          "appId": "1:885963963096:android:66f2997623d571f57775ad",
          "fileOutput": "android/app/google-services.json"
        }
      },
      "dart": {
        "lib/firebase_options.dart": {
          "projectId": "kabadiwala-connect-d4df6",
          "configurations": {
            "android": "1:885963963096:android:66f2997623d571f57775ad",
            "web": "1:885963963096:web:ae4a6a8fe99bace87775ad"
          }
        }
      }
    }
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "disallowLegacyRuntimeConfig": true,
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local"
      ],
      "predeploy": [
        "npm --prefix \"$RESOURCE_DIR\" run lint"
      ]
    }
  ],
  "firestore": {
    "rules": "firestore.rules"
  },
  "hosting": {
    "public": "build/web",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}
